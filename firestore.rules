rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath()).data;
    }

    // Signed in, has a profile, and not awaiting / refused admin approval.
    // Docs with no status field are treated as approved (pre-approval accounts).
    function isActive() {
      return isSignedIn()
             && exists(userPath())
             && !(userDoc().get('status', 'approved') in ['pending', 'rejected']);
    }

    function isAdmin() {
      return isActive() && userDoc().role == 'admin';
    }

    function isDesigner() {
      return isActive() && userDoc().role == 'designer';
    }

    function isClient() {
      return isActive() && userDoc().role == 'client';
    }

    // An admin-issued invite backs this profile: it exists, is unused, and any
    // prize claimed on the profile is exactly the prize the invite carries.
    function invitePath() {
      return /databases/$(database)/documents/invites/$(request.resource.data.inviteCode);
    }

    function hasValidInvite() {
      return request.resource.data.get('inviteCode', null) is string
             && exists(invitePath())
             && get(invitePath()).data.get('used', false) == false
             && get(invitePath()).data.get('prize', null) == request.resource.data.get('prize', null);
    }

    function giftUpdateOk() {
      let aff = request.resource.data.diff(resource.data).affectedKeys();
      return !aff.hasAny(['prize', 'giftUsed', 'inviteCode'])
             || (aff.hasOnly(['giftUsed', 'giftUsedAt']) && request.resource.data.giftUsed == true)
             || hasValidInvite();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Self sign-up lands as 'pending' and cannot carry a prize.
      // Invite / gift sign-up is pre-approved, but only against a real unused invite.
      allow create: if isAdmin() ||
                    (isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'client'
                    && (
                         (request.resource.data.get('status', '') == 'pending'
                          && !('prize' in request.resource.data))
                         || (request.resource.data.get('status', '') == 'approved'
                             && hasValidInvite())
                       ));

      // Only an admin moves someone between pending / approved / rejected.
      allow update: if isAdmin() ||
                    (request.auth.uid == userId &&
                     !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'uid', 'status']) &&
                     giftUpdateOk());
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, write: if isAdmin();

      // Designers: only their assigned projects; only status workflow fields
      allow read: if isDesigner() &&
                    resource.data.assignedDesignerEmail == request.auth.token.email;
      allow update: if isDesigner() &&
                      resource.data.assignedDesignerEmail == request.auth.token.email &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'htmlApproved']) &&
                      statusIn(['awaiting-client-approval', 'stl-ready', 'in-progress']) &&
                      request.resource.data.get('htmlApproved', false) is bool;

      allow read: if isClient() &&
                    resource.data.clientEmail == request.auth.token.email;

      // Clients open a case with known fields only: no self-assigned designer,
      // no VIP/urgent flags, no pre-approval; numeric fields must be numbers.
      allow create: if isClient() &&
                      request.resource.data.clientEmail == request.auth.token.email &&
                      request.resource.data.keys().hasOnly(['title', 'clientEmail', 'description', 'status', 'assignedDesignerEmail', 'htmlApproved', 'clientRemarks', 'createdAt', 'patientId', 'dueDate', 'giftTeeth', 'projectNo']) &&
                      request.resource.data.get('status', '') == 'pending' &&
                      request.resource.data.get('assignedDesignerEmail', null) == null &&
                      request.resource.data.get('htmlApproved', false) == false &&
                      request.resource.data.title is string &&
                      request.resource.data.title.size() <= 200 &&
                      request.resource.data.get('description', '') is string &&
                      request.resource.data.get('description', '').size() <= 5000 &&
                      (!('giftTeeth' in request.resource.data) ||
                        (request.resource.data.giftTeeth is int &&
                         request.resource.data.giftTeeth >= 0 &&
                         request.resource.data.giftTeeth <= 32)) &&
                      (!('projectNo' in request.resource.data) || request.resource.data.projectNo is int);

      allow update: if isClient() &&
                      resource.data.clientEmail == request.auth.token.email &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['htmlApproved', 'clientRemarks', 'remarksAt', 'approvedAt', 'stlDownloaded', 'stlDownloadedAt', 'stlDownloadedFile', 'status', 'clientDeleted', 'clientDeletedAt']) &&
                      statusIn(['approved', 'stl-ready', 'changes-requested', 'completed']) &&
                      request.resource.data.get('htmlApproved', false) is bool &&
                      (request.resource.data.get('clientRemarks', null) == null ||
                        (request.resource.data.clientRemarks is string &&
                         request.resource.data.clientRemarks.size() <= 5000));
    }

    // Unchanged status always passes; a changed status must be one the role may set.
    function statusIn(allowed) {
      return request.resource.data.get('status', '') == resource.data.get('status', '')
             || request.resource.data.get('status', '') in allowed;
    }

    // Landing-page design samples: public marketing content, managed by admins.
    match /landing-samples/{sampleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /invites/{inviteId} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isSignedIn()
                    && resource.data.get('used', false) == false
                    && resource.data.get('status', '') != 'redeemed'
                    && request.resource.data.get('status', '').matches('^[a-z_-]{0,20}$')
                    && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'openedAt', 'uid', 'used', 'usedAt', 'redeemedAt']);
    }

    // Sequential project numbers: one counter document, incremented by exactly 1 per new project
    match /counters/{counterId} {
      allow read: if isActive();
      allow create: if isAdmin() ||
                      (isActive() && counterId == 'projects' &&
                       request.resource.data.keys().hasOnly(['next']) &&
                       request.resource.data.next == 2);
      allow update: if isAdmin() ||
                      (isActive() &&
                       request.resource.data.keys().hasOnly(['next']) &&
                       request.resource.data.next == resource.data.next + 1);
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isActive()
                    && request.resource.data.keys().hasOnly(['eventType', 'userEmail', 'details', 'ipAddress', 'timestamp', 'userAgent'])
                    && request.resource.data.userEmail == request.auth.token.get('email', request.resource.data.userEmail)
                    && (request.resource.data.details == null || request.resource.data.details.size() < 1000);
      allow update, delete: if false;
    }

    match /nameChangeRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isActive() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
