rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isDesigner() {
      return isSignedIn() && myRole() == 'designer';
    }

    function isClient() {
      return isSignedIn() && myRole() == 'client';
    }

    // Signed in AND has a profile document (blocks bare anonymous / profile-less accounts)
    function isMember() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Gift fields may only come from the matching invite
    function giftCreateOk() {
      return (!('prize' in request.resource.data) && !('giftUsed' in request.resource.data))
        || (request.resource.data.get('inviteCode', null) != null
            && request.resource.data.get('prize', null) ==
               get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('prize', null));
    }

    // ...or flip giftUsed -> true
    function giftUpdateOk() {
      let aff = request.resource.data.diff(resource.data).affectedKeys();
      return !aff.hasAny(['prize', 'giftUsed', 'inviteCode'])
        || (aff.hasOnly(['giftUsed', 'giftUsedAt']) && request.resource.data.giftUsed == true)
        || (request.resource.data.get('inviteCode', null) != null
            && request.resource.data.get('prize', null) ==
               get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('prize', null));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'client'
                    && giftCreateOk();
      allow update: if isAdmin() ||
                    (request.auth.uid == userId &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']) &&
                     giftUpdateOk());
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, write: if isAdmin();

      // Designers: only their assigned projects; only status workflow fields
      allow read: if isDesigner() &&
                    resource.data.assignedDesignerEmail == request.auth.token.email;
      allow update: if isDesigner() &&
                      resource.data.assignedDesignerEmail == request.auth.token.email &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'htmlApproved']);

      allow read: if isClient() &&
                    resource.data.clientEmail == request.auth.token.email;
      allow create: if isClient() &&
                      request.resource.data.clientEmail == request.auth.token.email;
      allow update: if isClient() &&
                      resource.data.clientEmail == request.auth.token.email &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['htmlApproved', 'clientRemarks', 'remarksAt', 'approvedAt', 'stlDownloaded', 'stlDownloadedAt', 'stlDownloadedFile', 'status', 'clientDeleted', 'clientDeletedAt']);
    }

    match /invites/{inviteId} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isSignedIn()
                    && resource.data.get('used', false) == false
                    && resource.data.get('status', '') != 'redeemed'
                    && request.resource.data.get('status', '').matches('^[a-z_-]{0,20}$')
                    && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'openedAt', 'uid', 'used', 'usedAt', 'redeemedAt']);
    }

    // Sequential project numbers: one counter document, incremented by exactly 1 per new project
    match /counters/{counterId} {
      allow read: if isMember();
      allow create: if isAdmin() ||
                      (isMember() && counterId == 'projects' &&
                       request.resource.data.keys().hasOnly(['next']) &&
                       request.resource.data.next == 2);
      allow update: if isAdmin() ||
                      (isMember() &&
                       request.resource.data.keys().hasOnly(['next']) &&
                       request.resource.data.next == resource.data.next + 1);
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(['eventType', 'userEmail', 'details', 'ipAddress', 'timestamp', 'userAgent'])
                    && request.resource.data.userEmail == request.auth.token.get('email', request.resource.data.userEmail)
                    && (request.resource.data.details == null || request.resource.data.details.size() < 1000);
      allow update, delete: if false;
    }

    match /nameChangeRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isMember() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
